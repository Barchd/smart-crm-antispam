# Copy to .env. Do not commit .env.
# AI / bot / webhook secrets: CRM UI → /settings/ai|bot|webhook/ (head)
#
# Secrets without local Python:
#   DJANGO_SECRET_KEY=$(openssl rand -hex 32)
# Or after containers are up:
#   docker compose exec web python manage.py generate_tokens
#
# Server by IP/domain (avoid DisallowedHost):
#   DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,YOUR_IP_OR_DOMAIN
#   CRM_BASE_URL=http://YOUR_IP_OR_DOMAIN:8000
#
# Stable seed passwords (optional):
#   CRM_HEAD_PASSWORD=...
#   CRM_MANAGER1_PASSWORD=...
#   CRM_MANAGER2_PASSWORD=...
#
# Full list: docs/environment.md · Docker: docs/deployment.md

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CRM_BASE_URL=http://127.0.0.1:8000
